{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure: Linux Debug (Clang)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "linux-debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build: Linux Debug (Clang)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "out/build/linux-debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": [
                "Configure: Linux Debug (Clang)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Configure: Windows Debug (Clang)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset", "x64-debug-clang"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build: Windows Debug (Clang)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "out/build/x64-debug-clang" 
            ],
            "group": "build",
            "dependsOn": [
                "Configure: Windows Debug (Clang)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Clean (Clang)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "out/build/${input:cleanFolder}",
                "--target", "clean"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "cleanFolder",
            "type": "pickString",
            "description": "Which build folder do you want to clean?",
            "options": [
                "x64-debug-clang",
                "linux-debug"
            ],
            "default": "x64-debug-clang"
        }
    ]
}
